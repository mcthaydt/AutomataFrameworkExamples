{
  "name": "automataframework-examples",
  "version": "0.0.0",
  "private": true,
  "description": "The demo game made with AutomataFramework.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p .",
    "knip": "knip",
    "test:node": "vitest run --project node",
    "test:engine": "vitest run --passWithNoTests --project",
    "content:write": "node scripts/write-content.ts",
    "same-hash": "node scripts/same-hash.ts",
    "dev": "vite",
    "build": "vite build && node scripts/copy-game.ts",
    "preview": "vite preview",
    "test:journeys": "vitest run --project journeys"
  },
  "dependencies": {
    "@automataframework/framework": "github:mcthaydt/AutomataFramework#2a8b09f0e3a50c44343fb5072c5695f686095f43"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@automataframework/framework@https://codeload.github.com/mcthaydt/AutomataFramework/tar.gz/2a8b09f0e3a50c44343fb5072c5695f686095f43"
    ]
  }
}
